# ---------------------------------------------------------------------------
# Secretary server configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development            # development | production | test
HOST=127.0.0.1                  # use 0.0.0.0 inside containers
PORT=8787

# Public URL of the API, used to build OAuth redirect URIs:
#   ${PUBLIC_URL}/api/integrations/callback/{google|microsoft|slack|todoist}
PUBLIC_URL=http://localhost:8787
# Where the browser returns after OAuth (the web app).
APP_URL=http://localhost:5173
# Browser origins allowed to call the API (CORS + CSRF origin check). Include the desktop webview origins.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# postgres://user:pass@host:5432/db  (production)   or   pglite:///abs/path  (embedded, single node)
DATABASE_URL=postgres://secretary:secretary@localhost:5432/secretary
DATABASE_POOL_MAX=10

# REQUIRED. 32 random bytes, base64. Wraps every user's data-encryption key.
# Generate: pnpm --filter @secretary/server exec tsx src/genkey.ts
# Keep it in a secret manager. Losing it makes stored API keys / OAuth tokens unrecoverable.
MASTER_KEY=

SESSION_TTL_DAYS=30             # absolute session lifetime
SESSION_IDLE_DAYS=7             # sessions unused this long are revoked
COOKIE_SECURE=false             # MUST be true in production (HTTPS)
TRUST_PROXY=false               # true behind a reverse proxy / load balancer
SERVE_WEB_DIR=                  # path to apps/web/dist to serve the web app from the API origin

JOBS_ENABLED=true               # scheduler + worker in this process (safe to run on several instances)
JOB_TICK_SECONDS=30
SYNC_INTERVAL_MINUTES=15
ALLOW_SIGNUP=true
ALLOW_DEMO=true
LOG_LEVEL=info

# --- OAuth apps (see docs/SETUP-INTEGRATIONS.md). Leave empty to hide an integration. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common         # common | organizations | consumers | <tenant-id>
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# AI provider keys are NOT configured here: each user brings their own key in Settings → AI.
