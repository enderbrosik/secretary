{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Secretary",
  "version": "0.1.0",
  "identifier": "app.secretary.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @secretary/web dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Secretary",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI personal secretary",
    "longDescription": "Morning briefings, inbox triage, meeting prep and end-of-day reviews using your own AI provider and accounts.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/secretary-node"],
    "resources": { "resources/server/": "server/" },
    "macOS": { "minimumSystemVersion": "11.0", "entitlements": "./Entitlements.plist" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "linux": { "deb": { "depends": [] } }
  },
  "plugins": {
    "updater": { "pubkey": "", "endpoints": [] }
  }
}
