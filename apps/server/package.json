{
  "name": "@secretary/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.mjs",
    "build": "node build.mjs",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "LIVE_TESTS=1 vitest run test/live"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@secretary/ai": "workspace:*",
    "@secretary/core": "workspace:*",
    "@secretary/db": "workspace:*",
    "@secretary/integrations": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "hash-wasm": "^4.12.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "msw": "^2.15.0",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
